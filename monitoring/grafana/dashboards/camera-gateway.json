      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vigilantai_gateway_backend_publish_failures_total{job=\"vigilantai-camera-gateway\", environment=\"$environment\", instance=~\"$instance\"}[5m])",
          "legendFormat": "Failures/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "line",
