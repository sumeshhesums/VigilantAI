    {
      "id": 32,
      "title": "Publish Success Ratio",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (rate(vigilantai_gateway_backend_publish_failures_total{job=\"vigilantai-camera-gateway\", environment=\"$environment\", instance=~\"$instance\"}[5m]) / rate(vigilantai_gateway_backend_publishes_total{job=\"vigilantai-camera-gateway\", environment=\"$environment\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "Success Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
