    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 200,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Gateway Logs",
      "id": 201,
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 13 },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{service=\"camera-gateway\", environment=\"$environment\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Connection Errors",
      "id": 202,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{service=\"camera-gateway\", environment=\"$environment\"} |~ \"(?i)(disconnect|reconnect|error|timeout)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "timepicker": {},
  "version": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
