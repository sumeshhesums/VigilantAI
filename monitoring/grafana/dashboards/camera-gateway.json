      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vigilantai_gateway_ai_failures_total{job=\"vigilantai-camera-gateway\", environment=\"$environment\", instance=~\"$instance\"}[5m])",
          "legendFormat": "AI Failures/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
