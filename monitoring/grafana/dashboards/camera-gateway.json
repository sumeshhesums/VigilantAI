      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vigilantai_gateway_backend_publishes_total{job=\"vigilantai-camera-gateway\", environment=\"$environment\", instance=~\"$instance\"}[5m])",
          "legendFormat": "Publishes/s"
