# ============================================================
# VigilantAI Production Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# ============================================================

# -- PostgreSQL --
POSTGRES_USER=vigilant
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vigilantai
POSTGRES_PORT=5432

# -- Redis --
REDIS_PORT=6379

# -- Backend --
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
DATABASE_URL=postgres://vigilant:CHANGE_ME_STRONG_PASSWORD@postgres:5432/vigilantai
REDIS_URL=redis://redis:6379
RUST_LOG=backend=info,tower_http=info

# -- JWT (generate with: openssl genrsa 4096 | openssl pkcs8 -topk8 -nocrypt -outform PEM) --
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRY_SECS=900
JWT_REFRESH_TOKEN_EXPIRY_SECS=604800

# -- Evidence Storage --
EVIDENCE_STORAGE_PATH=/data/evidence
EVIDENCE_MAX_FILE_SIZE=20971520

# -- Notifications --
NOTIFICATION_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TIMEOUT_SECS=10
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_MAX_RETRIES=3

# -- AI Service --
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8081
AI_SERVICE_LOG_LEVEL=INFO
AI_SERVICE_DEFAULT_MODEL=yolov8n
AI_SERVICE_DEVICE=cpu
AI_SERVICE_AUTO_LOAD=true
AI_SERVICE_CONFIDENCE_THRESHOLD=0.5
AI_SERVICE_IOU_THRESHOLD=0.45

# -- Camera Gateway --
GATEWAY_PORT=8082
GATEWAY_AI_SERVICE_URL=http://ai-service:8081
GATEWAY_BACKEND_URL=http://backend:8080
GATEWAY_AUTH_TOKEN=

# -- Dashboard --
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
